{
  "name": "alegamestation",
  "productName": "AleGamestation",
  "version": "1.2.0",
  "description": "Konsolenmodus für Windows-PCs: alle Spiele & Emulatoren mit dem Controller vom Fernseher aus starten.",
  "main": "src/main/main.js",
  "author": "AleB-Roni",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --no-display-switch",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.alegamestation.app",
    "productName": "AleGamestation",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/xinput-watcher.ps1"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AleGamestation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AleGamestation",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AleB-Roni",
        "repo": "AleGamestation",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AleB-Roni/AleGamestation.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-hid": "^3.4.0"
  }
}
