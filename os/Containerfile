# AleGamestation OS – bootet direkt in AleGamestation (Gamescope-Spielmodus), Linux-Desktop per Menü oder Strg+Alt+D.
# Basis: Bazzite (Fedora Atomic, bootc) mit Treibern für AMD/Intel (bazzite-deck) bzw. NVIDIA (bazzite-deck-nvidia).
# Gebaut vom Release-Workflow aus dem Repo-Stamm: `dist/linux-unpacked` (Linux-Build der App) muss vorher existieren.
ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck:stable
FROM ${BASE_IMAGE}

ARG APP_VERSION=0.0.0
LABEL org.opencontainers.image.title="AleGamestation OS" \
      org.opencontainers.image.description="Konsolen-Betriebssystem mit AleGamestation als Oberfläche" \
      org.opencontainers.image.source="https://github.com/AleB-Roni/AleGamestation" \
      org.opencontainers.image.version="${APP_VERSION}"

# App (Linux-Build) und System-Dateien
COPY dist/linux-unpacked/ /usr/lib/alegamestation/
COPY os/system_files/ /
COPY os/kwin-setup.sh /tmp/kwin-setup.sh
COPY build/icon.png /usr/share/alegamestation/icon.png

RUN set -eux; \
    # Chromium-Sandbox der App
    chmod 4755 /usr/lib/alegamestation/chrome-sandbox; \
    ln -sf /usr/lib/alegamestation/alegamestation /usr/bin/alegamestation-app; \
    chmod 0755 /usr/bin/alegamestation /usr/bin/alegamestation-session /usr/bin/return-to-gamemode \
               /usr/libexec/alegamestation-session-select /usr/libexec/alegamestation-firstboot /usr/libexec/alegamestation-os-update \
               /usr/libexec/alegamestation-gpu-check /usr/libexec/alegamestation-tailscale /usr/libexec/alegamestation-apply-wallpaper \
               /usr/libexec/alegamestation-autostart /usr/libexec/alegamestation-shares \
               /usr/libexec/alegamestation-usb-setup; \
    echo "${APP_VERSION}" > /usr/share/alegamestation/os-version; \
    # xprop: eigene Fenster (Overlay, Tastatur) als Gamescope-Overlay markieren; unzip: RetroArch-Cores
    dnf5 install -y --setopt=install_weak_deps=False xprop unzip || dnf install -y xprop unzip; \
    # Tailscale (Fernzugriff) – in Bazzite meist schon enthalten
    command -v tailscale >/dev/null || dnf5 install -y tailscale || true; \
    systemctl enable tailscaled.service || true; \
    dnf5 clean all || true; \
    # Ersteinrichtung (Emulatoren, Cores, ROM-Ordner) für jeden Benutzer beim ersten Anmelden
    systemctl --global enable alegamestation-firstboot.service; \
    # USB-Stick-Abbild: Partition beim ersten Start vergrößern, Deutsch einstellen (nicht bei Installer-Installationen)
    systemctl enable alegamestation-usb-setup.service; \
    # Bazzite bootet sonst in die Steam-Oberfläche – AleGamestation ist der Spielmodus
    sed -i 's/^Session=.*/Session=plasma.desktop/' /usr/lib/sddm/sddm.conf.d/holo.conf || true; \
    # Desktop läuft immer, AleGamestation startet darauf im Vollbild; KWin-Regeln dafür
    bash /tmp/kwin-setup.sh /etc/xdg && rm -f /tmp/kwin-setup.sh; \
    # SMB-Freigaben bei jedem Start einrichten
    systemctl enable alegamestation-shares.service; \
    # Neue Benutzer: Bazzite Portal nicht bei jeder Anmeldung öffnen; Desktop-Symbol „Return to Gaming Mode“
    # führt (über return-to-gamemode) zu AleGamestation – Name und Symbol entsprechend
    rm -f /etc/skel/.config/autostart/bazzite-portal.desktop; \
    mkdir -p /etc/skel/Desktop; \
    printf '%s\n' '[Desktop Entry]' 'Name=Zurück zu AleGamestation' 'Comment=AleGamestation im Vollbild nach vorne holen' 'Exec=/usr/bin/return-to-gamemode' 'Icon=/usr/share/alegamestation/icon.png' 'Terminal=false' 'Type=Application' 'StartupNotify=false' > /etc/skel/Desktop/Return.desktop; \
    chmod +x /etc/skel/Desktop/Return.desktop; \
    rm -rf /var/* /tmp/* || true; \
    bootc container lint || true
