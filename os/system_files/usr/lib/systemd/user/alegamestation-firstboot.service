[Unit]
Description=AleGamestation OS – Ersteinrichtung (Emulatoren, RetroArch-Cores, ROM-Ordner)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!%h/.config/alegamestation-os/setup-done

[Service]
# exec statt oneshot: darf den Start des Spielmodus nicht aufhalten (dauert beim ersten Start ~15 Minuten)
Type=exec
ExecStart=/usr/libexec/alegamestation-firstboot
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
