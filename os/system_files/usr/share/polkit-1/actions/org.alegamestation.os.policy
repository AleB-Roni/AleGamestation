<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AleGamestation OS</vendor>
  <action id="org.alegamestation.os.session-select">
    <description>Spielmodus/Desktop für die nächste Anmeldung wählen</description>
    <message>Anmelde-Sitzung ändern</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/alegamestation-session-select</annotate>
  </action>
  <action id="org.alegamestation.os.update">
    <description>AleGamestation OS aktualisieren</description>
    <message>System aktualisieren</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/alegamestation-os-update</annotate>
  </action>
</policyconfig>
