#!/usr/bin/bash
# AleGamestation OS – Ersteinrichtung pro Benutzer (läuft beim ersten Anmelden, auch aus der App: „Emulatoren einrichten“)
#  - Emulatoren als Flatpak (Flathub, nur für diesen Benutzer – kein Passwort nötig)
#  - RetroArch-Cores (libretro-Buildbot)
#  - ROM-Ordner unter ~/ROMs, Zugriff der Emulatoren auf das Home-Verzeichnis
#  - Desktop-Symbol „Zurück zu AleGamestation“
set -uo pipefail
FORCE=0; [ "${1:-}" = "--force" ] && FORCE=1
DONE="$HOME/.config/alegamestation-os/setup-done"
[ -f "$DONE" ] && [ "$FORCE" = 0 ] && exit 0

say() { echo "$*"; }
EMULATORS=(
  org.libretro.RetroArch
  net.kuribo64.melonDS
  org.DolphinEmu.dolphin-emu
  org.duckstation.DuckStation
  net.pcsx2.PCSX2
  org.ppsspp.PPSSPP
)
CORES=(snes9x mesen mgba mupen64plus_next genesis_plus_gx)
ROMDIRS=(nes snes n64 gba nds gamecube wii megadrive psx ps2 psp)

# Netzwerk abwarten (bis 2 Minuten)
for i in $(seq 1 24); do
  curl -fsS --max-time 5 -o /dev/null https://dl.flathub.org/ && break
  [ "$i" = 1 ] && say "Warte auf Internetverbindung …"
  sleep 5
done

say "Flathub einrichten …"
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

failed=0
n=0
for app in "${EMULATORS[@]}"; do
  n=$((n + 1))
  if flatpak info "$app" >/dev/null 2>&1; then
    say "Emulator ${n}/${#EMULATORS[@]}: ${app##*.} ist schon da"
  else
    say "Emulator ${n}/${#EMULATORS[@]}: ${app##*.} wird installiert …"
    flatpak install --user --noninteractive -y flathub "$app" >/dev/null 2>&1 || { say "Fehler bei ${app##*.}"; failed=1; }
  fi
  # Emulatoren dürfen die ROMs im Home-Verzeichnis lesen
  flatpak override --user --filesystem=home "$app" >/dev/null 2>&1 || true
done

CORE_DIR="$HOME/.var/app/org.libretro.RetroArch/config/retroarch/cores"
mkdir -p "$CORE_DIR"
for c in "${CORES[@]}"; do
  f="$CORE_DIR/${c}_libretro.so"
  [ -f "$f" ] && [ "$FORCE" = 0 ] && continue
  say "RetroArch-Core: $c …"
  tmp="$(mktemp -d)"
  if curl -fsSL --retry 3 -o "$tmp/core.zip" "https://buildbot.libretro.com/nightly/linux/x86_64/latest/${c}_libretro.so.zip" \
     && unzip -o -q "$tmp/core.zip" -d "$CORE_DIR"; then :; else say "Fehler beim Core $c"; failed=1; fi
  rm -rf "$tmp"
done

for d in "${ROMDIRS[@]}"; do mkdir -p "$HOME/ROMs/$d"; done
say "ROM-Ordner: ~/ROMs"

# Desktop-Symbol „Zurück zu AleGamestation“
DESK="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
mkdir -p "$DESK"
cp -f /usr/share/applications/alegamestation-return.desktop "$DESK/" 2>/dev/null && chmod +x "$DESK/alegamestation-return.desktop" || true

if [ "$failed" = 0 ]; then
  mkdir -p "$(dirname "$DONE")"; date > "$DONE"
  say "Einrichtung fertig"
  exit 0
fi
say "Einrichtung unvollständig – wird beim nächsten Start erneut versucht"
exit 1
