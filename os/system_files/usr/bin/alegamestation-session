#!/usr/bin/bash
# Zwischen AleGamestation und Linux-Desktop wechseln – als normaler Benutzer aufrufen.
#   alegamestation-session game        → AleGamestation nach vorne holen (Desktop läuft weiter)
#   alegamestation-session desktop     → AleGamestation minimieren, Desktop nutzen
#   alegamestation-session gamescope   → reiner Gamescope-Spielmodus (meldet ab)
#   alegamestation-session steam       → Steam-Spielmodus von Bazzite (meldet ab)
set -uo pipefail
mode="${1:-game}"
case "$mode" in game|desktop|gamescope|steam) ;; *) echo "Unbekannter Modus: $mode" >&2; exit 2 ;; esac

in_gamescope=0
systemctl --user is-active --quiet 'gamescope-session-plus@*.service' && in_gamescope=1

logout_now() {
  if [ "$in_gamescope" = 1 ]; then
    systemctl --user stop 'gamescope-session-plus@*.service' || true
  elif systemctl --user is-active --quiet plasma-workspace.target; then
    # Plasma ordentlich abmelden (sonst laufen KWin & Co. weiter und blockieren den Bildschirm)
    for q in qdbus-qt6 qdbus6 qdbus; do
      if command -v "$q" >/dev/null && "$q" org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null; then
        for _ in $(seq 1 30); do systemctl --user is-active --quiet plasma-workspace.target || exit 0; sleep 0.5; done
        break
      fi
    done
    systemctl --user stop plasma-workspace.target plasma-kwin_wayland.service 2>/dev/null || true
  fi
  [ -n "${XDG_SESSION_ID:-}" ] && loginctl terminate-session "$XDG_SESSION_ID" 2>/dev/null || true
}

case "$mode" in
  game|desktop)
    rm -f "$HOME/.config/alegamestation-os/no-autostart"
    pkexec /usr/libexec/alegamestation-session-select "$mode" >/dev/null || true
    if [ "$in_gamescope" = 1 ]; then logout_now; exit 0; fi
    # Im Desktop: nichts abmelden – die App holt sich nach vorne bzw. minimiert sich
    if [ "$mode" = game ]; then exec /usr/bin/alegamestation; else exec /usr/bin/alegamestation --to-desktop; fi
    ;;
  gamescope|steam)
    pkexec /usr/libexec/alegamestation-session-select "$mode"
    logout_now
    ;;
esac
