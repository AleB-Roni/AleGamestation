#!/usr/bin/bash
# Zwischen Spielmodus (AleGamestation) und Linux-Desktop wechseln – als normaler Benutzer aufrufen.
#   alegamestation-session desktop   → Linux-Desktop (KDE Plasma / GNOME)
#   alegamestation-session game      → AleGamestation (Spielmodus)
#   alegamestation-session steam     → Steam-Spielmodus von Bazzite
set -euo pipefail
mode="${1:-game}"
case "$mode" in desktop|game|steam) ;; *) echo "Unbekannter Modus: $mode" >&2; exit 2 ;; esac

# Anmelde-Sitzung für den nächsten automatischen Login festlegen (braucht root → pkexec, ohne Passwort für wheel)
pkexec /usr/libexec/alegamestation-session-select "$mode"

# Schon im gewünschten Modus? Dann nur die Einstellung merken – nicht abmelden
# (sonst startet z.B. der Desktop unnötig neu und KDE stürzt dabei gelegentlich ab)
in_gamescope=0
systemctl --user is-active --quiet 'gamescope-session-plus@*.service' && in_gamescope=1
if [ "$mode" = desktop ] && [ "$in_gamescope" = 0 ]; then
  echo "Schon im Desktop – nächster Start: Desktop"
  exit 0
fi

# Aktuelle Sitzung beenden – SDDM meldet automatisch in der neuen Sitzung an
if systemctl --user is-active --quiet 'gamescope-session-plus@*.service'; then
  systemctl --user stop 'gamescope-session-plus@*.service' || true
fi
# KDE Plasma läuft als systemd-Benutzerdienste weiter, wenn nur die Anmeldesitzung beendet wird – dann kämpfen
# KWin und Gamescope um den Bildschirm (schwarzes Bild/Absturz). Deshalb Plasma ordentlich abmelden.
if systemctl --user is-active --quiet plasma-workspace.target; then
  for q in qdbus-qt6 qdbus6 qdbus; do
    if command -v "$q" >/dev/null && "$q" org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null; then
      # Warten, bis Plasma beendet ist (max. 15 s), sonst hart beenden
      for _ in $(seq 1 30); do systemctl --user is-active --quiet plasma-workspace.target || exit 0; sleep 0.5; done
      break
    fi
  done
  systemctl --user stop plasma-workspace.target plasma-kwin_wayland.service 2>/dev/null || true
fi
if [ -n "${XDG_SESSION_ID:-}" ]; then
  loginctl terminate-session "$XDG_SESSION_ID" || true
else
  loginctl terminate-user "$(id -un)" || true
fi
